#!/usr/bin/env python3
"""pdf-measure — count the characters per line in a rendered PDF.

    pdf-measure <file.pdf> [--target 66] [--pages 1-4]

Bringhurst's first rule of the page is the MEASURE: 45–75 characters per line,
66 ideal. Past ~75 the eye loses the line on the return sweep and the page
reads as a grey slab; below ~45 it stutters. Everything else in a document's
typography is downstream of getting this one number right.

WHY THIS TOOL EXISTS — the rule you cannot follow by arithmetic
---------------------------------------------------------------
The point size does NOT carry the measure across a change of font or of
rendering engine. Two engines setting the same nominal size of the same named
font gave 68 characters and 89 characters on the same column width: one was
embedding the face differently. A column that measures beautifully on the
machine it was designed on can be a slab on yours.

So the measure is established by MEASURING THE ARTEFACT, never by computing it
from point sizes. This tool reads the finished PDF and tells you where you
actually landed — and, if you are outside the band, what column width to try.

It measures SET LINES only: lines that fill the column. Headings, the last line
of a paragraph, table cells and footers are short by nature and would drag the
average down, so lines narrower than 92% of the widest line are excluded from
the count and reported separately.

Part of claude-typeset. MIT.
"""
import sys, argparse, statistics


def parse_pages(spec, n):
    if not spec:
        return range(n)
    out = []
    for part in spec.split(','):
        part = part.strip()
        if '-' in part:
            a, b = part.split('-', 1)
            out.extend(range(int(a) - 1, int(b)))
        else:
            out.append(int(part) - 1)
    return [i for i in out if 0 <= i < n]


def main():
    ap = argparse.ArgumentParser(
        description="Measure characters per line in a PDF (Bringhurst 45-75, 66 ideal).")
    ap.add_argument('pdf')
    ap.add_argument('--target', type=float, default=66.0,
                    help='ideal characters per line (default 66)')
    ap.add_argument('--pages', help='e.g. 1-4 or 2,5 (default: all)')
    ap.add_argument('--fill', type=float, default=0.92,
                    help='a line counts as SET if it is this fraction of the '
                         'widest line (default 0.92)')
    a = ap.parse_args()

    try:
        import fitz
    except ImportError:
        sys.exit("pdf-measure needs PyMuPDF:  pip install pymupdf")

    doc = fitz.open(a.pdf)
    lines = []          # (chars, width_pt, size, font)
    for i in parse_pages(a.pages, doc.page_count):
        for block in doc[i].get_text("dict")["blocks"]:
            if block.get("type") != 0:
                continue                      # not text
            for ln in block["lines"]:
                text = "".join(s["text"] for s in ln["spans"])
                if not text.strip():
                    continue
                x0, _, x1, _ = ln["bbox"]
                span = max(ln["spans"], key=lambda s: len(s["text"]))
                lines.append((len(text.rstrip()), x1 - x0,
                              round(span["size"], 1), span["font"]))
    doc.close()

    if not lines:
        sys.exit("pdf-measure: no text found — is this a scan rather than a "
                 "text PDF? Nothing to measure.")

    widths = sorted(w for _, w, _, _ in lines)
    column = widths[int(len(widths) * 0.95)]          # robust max, not the max
    cutoff = column * a.fill
    full = [(c, w, s, f) for c, w, s, f in lines if w >= cutoff]

    if len(full) < 5:
        print(f"⚠ only {len(full)} full-width lines found — too few to measure "
              f"reliably. Measure a longer stretch of running prose.")
        if not full:
            return

    cpl = [c for c, _, _, _ in full]
    med = statistics.median(cpl)
    mean = statistics.mean(cpl)
    col_mm = column / 72 * 25.4

    sizes = {}
    for c, _, s, f in full:
        sizes[(f, s)] = sizes.get((f, s), 0) + 1
    face, pt = max(sizes, key=sizes.get)

    print(f"\n  {a.pdf}")
    print(f"  {'─' * 58}")
    print(f"  body face      {face} @ {pt}pt")
    print(f"  column         {col_mm:.1f}mm  ({column:.0f}pt)")
    print(f"  set lines      {len(full)} of {len(lines)} "
          f"({len(lines) - len(full)} short: headings, paragraph ends, cells)")
    print(f"  characters     median {med:.0f}   mean {mean:.1f}   "
          f"range {min(cpl)}–{max(cpl)}")
    print(f"  {'─' * 58}")

    if 45 <= med <= 75:
        near = "  ← ideal" if abs(med - a.target) <= 3 else ""
        print(f"  ✓ IN THE BAND. {med:.0f} characters sits inside 45–75."
              f"{near}\n")
        if abs(med - a.target) > 8:
            suggest(col_mm, med, a.target, soft=True)
    else:
        verdict = "TOO WIDE — the eye will lose the line on the return sweep" \
            if med > 75 else "TOO NARROW — the line will stutter"
        print(f"  ✗ OUT OF BAND: {med:.0f} characters. {verdict}.\n")
        suggest(col_mm, med, a.target, soft=False)


def suggest(col_mm, med, target, soft):
    new = col_mm * target / med
    lead = "  Optional:" if soft else "  Fix:"
    print(f"{lead} width scales roughly with character count, so for ~{target:.0f}:\n")
    print(f"      render-doc <file>.md --pdf --measure {new:.0f}mm\n")
    print("  Then run pdf-measure again. One knob, one instrument, "
          "two or three passes.\n")


if __name__ == '__main__':
    main()
